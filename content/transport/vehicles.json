// Техника и правила перевозок (docs/11, docs/11a, docs/12, docs/14).
// Модели — реальные прототипы из каталога docs/11a_vehicle_models.md, только грузовые и без электротяги:
// электровозам и электричкам нужна контактная сеть, пассажирской технике — пассажиры (темы ещё не обсуждены).
// availableFromYear — с какого года модель продаётся (по «ориентиру появления» каталога, уточняется при балансе).
// Все игровые числа ВРЕМЕННЫЕ: speed — клеток за час, capacity — т (у грузовиков — реальная грузоподъёмность),
// length — единиц длины (2 единицы на клетку пути), maxWagons — сколько вагонов тянет локомотив.
{
  "networks": [
    // stopSlots — сколько машин пункт обслуживает одновременно (docs/12: от 2 до 10), остальные ждут.
    // У поездов мест столько, сколько у станции путей (docs/10), а очередь регулируют сигналы.
    // wagonsPerStopCell — вдоль клетки платформы стоят два вагона; состав длиннее платформы
    // обрабатывается медленнее — пропорционально тому, какая его часть помещается у платформы.
    { "network": "rail", "depot": "rail_depot", "stopParts": ["rail_station"], "stopFacilities": [],
      "unitsPerCell": 2, "trains": true, "wagonsPerStopCell": 2 },
    { "network": "road", "depot": "truck_garage", "stopParts": ["truck_station"], "stopFacilities": ["city_truck_stop"],
      "unitsPerCell": 1, "trains": false,
      "stopSlots": { "truck_station": 4, "city_truck_stop": 4 } }
  ],

  // Кузова грузовиков (docs/11a): кузов задаёт допустимые грузы.
  "bodies": [
    { "id": "flatbed", "title": "бортовой", "cargo": ["steel"] },
    { "id": "dump", "title": "самосвал", "cargo": ["coal", "iron_ore"] }
  ],

  "models": [
    // --- Паровозы ---
    { "id": "steam_fd", "title": "Паровоз ФД", "role": "locomotive", "network": "rail",
      "availableFromYear": 1950, "speed": 1.4, "maxWagons": 20, "length": 2 },
    // Стартовый паровоз прототипа (docs/11b): 12 гружёных вагонов — временный предел до модели тяги.
    { "id": "steam_l", "title": "Паровоз Л", "role": "locomotive", "network": "rail",
      "availableFromYear": 1950, "speed": 1.5, "maxWagons": 12, "length": 2 },

    // --- Магистральные тепловозы ---
    { "id": "diesel_te2", "title": "Тепловоз ТЭ2", "role": "locomotive", "network": "rail",
      "availableFromYear": 1950, "speed": 1.6, "maxWagons": 12, "length": 2 },
    { "id": "diesel_te3", "title": "Тепловоз ТЭ3", "role": "locomotive", "network": "rail",
      "availableFromYear": 1956, "speed": 1.8, "maxWagons": 18, "length": 3 },
    { "id": "diesel_2te116", "title": "Тепловоз 2ТЭ116", "role": "locomotive", "network": "rail",
      "availableFromYear": 1972, "speed": 2.0, "maxWagons": 24, "length": 3 },
    { "id": "diesel_2te121", "title": "Тепловоз 2ТЭ121", "role": "locomotive", "network": "rail",
      "availableFromYear": 1985, "speed": 2.0, "maxWagons": 28, "length": 3 },

    // --- Вагоны ---
    { "id": "gondola", "title": "Полувагон", "role": "wagon", "network": "rail",
      "availableFromYear": 1950, "capacity": 60, "cargo": ["coal", "iron_ore"], "length": 1 },
    { "id": "flatcar", "title": "Платформа", "role": "wagon", "network": "rail",
      "availableFromYear": 1950, "capacity": 50, "cargo": ["steel"], "length": 1 },

    // --- Лёгкие грузовики ---
    { "id": "uaz_450d", "title": "УАЗ-450Д", "role": "truck", "network": "road",
      "availableFromYear": 1958, "speed": 2.2, "capacity": 0.8, "bodies": ["flatbed"], "length": 1 },
    { "id": "uaz_3303", "title": "УАЗ-3303", "role": "truck", "network": "road",
      "availableFromYear": 1985, "speed": 2.4, "capacity": 1.2, "bodies": ["flatbed"], "length": 1 },
    { "id": "gaz_3302", "title": "ГАЗ-3302 «Газель»", "role": "truck", "network": "road",
      "availableFromYear": 1994, "speed": 2.6, "capacity": 1.5, "bodies": ["flatbed"], "length": 1 },

    // --- Средние грузовики ---
    // Стартовый грузовик прототипа (docs/11b): реальная грузоподъёмность 2,5 т.
    { "id": "gaz_51", "title": "ГАЗ-51", "role": "truck", "network": "road",
      "availableFromYear": 1950, "speed": 2.0, "capacity": 2.5, "bodies": ["flatbed", "dump"], "length": 1 },
    { "id": "gaz_53a", "title": "ГАЗ-53А", "role": "truck", "network": "road",
      "availableFromYear": 1962, "speed": 2.2, "capacity": 4, "bodies": ["flatbed", "dump"], "length": 1 },
    { "id": "gaz_3307", "title": "ГАЗ-3307", "role": "truck", "network": "road",
      "availableFromYear": 1989, "speed": 2.4, "capacity": 4.5, "bodies": ["flatbed", "dump"], "length": 1 },
    { "id": "gaz_3309", "title": "ГАЗ-3309", "role": "truck", "network": "road",
      "availableFromYear": 1994, "speed": 2.5, "capacity": 4.5, "bodies": ["flatbed", "dump"], "length": 1 },

    // --- Тяжёлые грузовики ---
    { "id": "maz_200", "title": "МАЗ-200", "role": "truck", "network": "road",
      "availableFromYear": 1950, "speed": 1.8, "capacity": 7, "bodies": ["flatbed", "dump"], "length": 1 },
    { "id": "maz_500a", "title": "МАЗ-500А", "role": "truck", "network": "road",
      "availableFromYear": 1970, "speed": 2.2, "capacity": 8, "bodies": ["flatbed", "dump"], "length": 1 },
    { "id": "kamaz_5320", "title": "КамАЗ-5320", "role": "truck", "network": "road",
      "availableFromYear": 1976, "speed": 2.4, "capacity": 8, "bodies": ["flatbed", "dump"], "length": 1 },
    { "id": "kamaz_53212", "title": "КамАЗ-53212", "role": "truck", "network": "road",
      "availableFromYear": 1980, "speed": 2.4, "capacity": 10, "bodies": ["flatbed"], "length": 1 },
    { "id": "kamaz_65115", "title": "КамАЗ-65115", "role": "truck", "network": "road",
      "availableFromYear": 1998, "speed": 2.5, "capacity": 15, "bodies": ["dump"], "length": 1 }
  ],

  // Износ растёт на каждой клетке пути; после разгрузки при износе от serviceAt техника едет на обслуживание.
  "maintenance": { "wearPerCell": 0.0005, "serviceAt": 0.8, "serviceHours": 24 },

  // Сколько часов ждать полной загрузки, прежде чем ехать с тем, что уже погружено.
  "loading": { "maxWaitHours": 48 },

  // Движение поездов по сигналам (docs/10а, docs/12). Все числа временные.
  //   occupiedDelayHours — ожидаемая задержка за занятый другим поездом участок при выборе маршрута;
  //   reverseDelayHours  — ожидаемая задержка разворота при выборе маршрута;
  //   reverseAfterHours  — через сколько часов у красного сигнала разворачивается поезд с такой настройкой;
  //   stuckWarningHours  — через сколько часов стоянки у красного сигнала игрок получает предупреждение;
  //   wreckHours         — сколько часов обломки после крушения занимают путь;
  //   crossingCloseCells — за сколько клеток подходящий поезд закрывает переезд для машин.
  "railTraffic": {
    "occupiedDelayHours": 6, "reverseDelayHours": 2, "reverseAfterHours": 6,
    "stuckWarningHours": 48, "wreckHours": 48, "crossingCloseCells": 2
  }
}
