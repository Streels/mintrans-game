// Темп игры (docs/03_simulation_time.md). Один шаг симуляции — всегда один игровой час.
{
  // Сколько реальных секунд длится игровой час на скорости 1×. Предварительно: неделя ≈ 5,6 минуты.
  "secondsPerHourAt1x": 2.0,
  // Доступные скорости. Скорость меняет только частоту шагов, но не их результат.
  "speeds": [1, 2, 4, 8],
  // Предел шагов за кадр: если компьютер не успевает, игра замедляется, а не зависает.
  "maxStepsPerFrame": 32
}
