    },
    {
      "id": "vegetation",
      "default": "none",
      "kinds": [ { "id": "none" }, { "id": "forest" } ]
    },
    {
      "id": "water",
      "default": "none",
      "kinds": [ { "id": "none" }, { "id": "river" }, { "id": "lake" } ]
    },
    {
      "id": "deposit",
      "default": "none",
      "kinds": [ { "id": "none" }, { "id": "coal" }, { "id": "iron_ore" } ]
    }
  ]
