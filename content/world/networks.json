// Транспортные сети. Водные пути и авиалинии добавятся сюда позже.
// layout — как устроена сеть:
//   "edges" — дорога по клеткам 5×5 м: в клетке все стороны, к которым она подходит, соединены между собой;
//             диагональ — лесенка клеток, как в OpenTTD;
//   "graph" — рельсы: граф путей на метрической геометрии из прямых и дуг (docs/02в, docs/10в);
//             клетки — только адреса для правил и индекса, соединяют пути общие узлы.
{
  "networks": [
    { "id": "road", "layout": "edges" },
    { "id": "rail", "layout": "graph" }
  ]
}
