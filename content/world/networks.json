// Транспортные сети. Водные пути и авиалинии добавятся сюда позже.
// layout — как сеть устроена внутри клетки:
//   "edges"  — дорога: в клетке все стороны, к которым она подходит, соединены между собой;
//   "tracks" — рельсы: куски пути (прямые и угловые), повороты только по уложенным кускам.
// Клетки соединяются только через стороны; диагональ — лесенка угловых кусков, как в OpenTTD.
{
  "networks": [
    { "id": "road", "layout": "edges" },
    { "id": "rail", "layout": "tracks" }
  ]
}
