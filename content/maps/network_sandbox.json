// Песочница для проверки сетей: рельсы на метрической геометрии (docs/10в) — прямые, кривые, стрелка, мост,
// сигналы, переезд; дороги по клеткам — перекрёсток, поворот, тупик, лесенка.
// Не часть прототипа — карта для разработки и визуальной проверки. Клетка — 5 м, карта 1,2 × 0,8 км.
{
  "format": 1,
  "id": "network_sandbox",
  "name": "Песочница сетей",
  "size": [240, 160],

  "terrain": [
    { "op": "fill", "layer": "surface", "kind": "meadow" },
    // Ручей поперёк карты: его пересекает ж/д мост.
    { "op": "path", "layer": "water", "kind": "river", "width": 2, "points": [[96, 0], [100, 60], [104, 160]] }
  ],

  "networks": [
    // Главная линия: прямая на восток, кривая радиусом 200 м вниз, по диагонали и обратно на восток.
    { "op": "rail", "points": [[10, 20], [80, 20], [120, 60], [230, 60]], "radius": 200 },
    // Стрелка: ответвление с прямого участка дугой и прямой в тупик.
    { "op": "rail_connect", "from": [40, 20], "to": [4, 36] },
    // Поперечная линия проходит над главной по мосту — независимые линии на одном уровне не пересекаются.
    { "op": "rail", "points": [[50, 2], [50, 12]] },
    { "op": "rail_bridge", "from": [50, 12], "to": [50, 28] },
    { "op": "rail", "points": [[50, 28], [50, 50]] },
    // Мост главной линии над ручьём.
    { "op": "rail", "points": [[120, 90], [94, 90]] },
    { "op": "rail_bridge", "from": [94, 90], "to": [86, 90] },
    { "op": "rail", "points": [[86, 90], [10, 90]] },
    // Сигналы на прямом участке: блочный в сторону востока и двусторонний маршрутный.
    { "op": "rail_signal", "kind": "block_signal", "logic": "block", "at": [60, 20], "toward": "east" },
    { "op": "rail_signal", "kind": "path_signal", "logic": "path", "at": [215, 60] },
    // Переезд: дорога поперёк прямого пути.
    { "op": "line", "network": "road", "points": [[200, 50], [200, 70]] },
    // Дороги: улица с Т-образным перекрёстком, поворотом и тупиком.
    { "op": "line", "network": "road", "points": [[20, 120], [60, 120]] },
    { "op": "line", "network": "road", "points": [[40, 120], [40, 140], [70, 140]] },
    // Дорога лесенкой — диагональ по тем же правилам.
    { "op": "line", "network": "road", "points": [[120, 110], [140, 130]] }
  ],

  // Завод 6x6 с модулем углом — площадка непрямоугольная (docs/06). Ж/д платформу к нему ставит игрок.
  "sites": [
    { "key": "plant", "type": "steel_plant", "name": "Завод", "rect": [20, 94, 6, 6],
      "parts": [
        { "kind": "workshop", "rect": [26, 96, 2, 2] }
      ] }
  ]
}
