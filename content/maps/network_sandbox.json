// Песочница для проверки сетей: повороты, диагонали, мост, переезд, сигналы, тупики.
// Не часть прототипа — карта для разработки и визуальной проверки.
{
  "format": 1,
  "id": "network_sandbox",
  "name": "Песочница сетей",
  "size": [40, 32],

  "terrain": [
    { "op": "fill", "layer": "surface", "kind": "meadow" }
  ],

  "networks": [
    // Рельсы: прямая, поворот, диагональ лесенкой и обратно в прямую.
    { "op": "line", "network": "rail", "points": [[2, 4], [12, 4], [20, 12], [36, 12]] },
    // Рельсы: крест — поперечная линия пересекает первую в одном уровне (8,4), поезда идут через него прямо.
    { "op": "line", "network": "rail", "points": [[8, 1], [8, 8]] },
    // Рельсы: вторая линия проходит над первой по мосту — так линии не мешают друг другу (docs/10б).
    { "op": "bridge", "network": "rail", "kind": "rail_bridge", "from": [16, 6], "to": [16, 9] },
    { "op": "line", "network": "rail", "points": [[16, 2], [16, 5]] },
    { "op": "line", "network": "rail", "points": [[16, 10], [16, 20]] },
    // Сигналы на прямом участке: блочный в сторону востока и двусторонний маршрутный.
    { "op": "signal", "network": "rail", "kind": "block_signal", "logic": "block", "at": [24, 12], "toward": "east" },
    { "op": "signal", "network": "rail", "kind": "path_signal", "logic": "path", "at": [33, 12] },
    // Переезд: дорога поперёк прямого пути.
    { "op": "line", "network": "road", "points": [[29, 8], [29, 16]] },
    // Рельсы: поворот под прямым углом.
    { "op": "line", "network": "rail", "points": [[24, 2], [30, 2], [30, 8]] },
    // Дороги: улица с Т-образным перекрёстком, поворотом и тупиком.
    { "op": "line", "network": "road", "points": [[2, 22], [20, 22]] },
    { "op": "line", "network": "road", "points": [[10, 22], [10, 29], [18, 29]] },
    // Дорога лесенкой — диагональ по тем же правилам.
    { "op": "line", "network": "road", "points": [[24, 18], [34, 28]] },
    // Подъездной путь к станции завода.
    { "op": "line", "network": "rail", "points": [[2, 16], [8, 16]] }
  ],

  // Завод 3x3 с присоединённой станцией сбоку и модулем углом — площадка непрямоугольная (docs/06, docs/10).
  "sites": [
    { "key": "plant", "type": "steel_plant", "name": "Завод", "rect": [3, 12, 3, 3],
      "parts": [
        { "kind": "rail_station", "rect": [3, 15, 5, 1] },
        { "kind": "workshop", "rect": [6, 13, 2, 2] }
      ] }
  ]
}
