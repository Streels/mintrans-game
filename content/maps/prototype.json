// Тестовая карта первого прототипа (docs/01_first_prototype.md, docs/02_world_map.md).
// 40×40 км: 8 000×8 000 строительных клеток по 5 м, хранятся разреженно (docs/02в). Рельеф — на крупной сетке
// с шагом 20 клеток (100 м). Мало объектов, большие расстояния: шахты в 6–7 км от завода, город в 1,6 км от него.
// Рельеф не плоский, внешних дорог и путей нет — их строит игрок. Координаты — в клетках.
{
  "format": 1,
  "id": "prototype",
  "name": "Прототип: уголь, руда, сталь",
  "size": [8000, 8000],
  "terrainStep": 20,
  "seed": 0,

  "terrain": [
    { "op": "fill", "layer": "surface", "kind": "grass" },

    // Горный массив на северо-западе и скалистые вершины.
    { "op": "hill", "center": [1600, 1400], "radius": [2400, 1800], "height": 16 },
    { "op": "hill", "center": [600, 2700], "radius": [1000, 900], "height": 8 },
    { "op": "ellipse", "layer": "surface", "kind": "rock", "center": [1500, 1300], "radius": [1100, 800] },

    // Возвышенности в центре и на юго-востоке.
    { "op": "hill", "center": [3300, 2500], "radius": [700, 500], "height": 6 },
    { "op": "hill", "center": [6400, 6400], "radius": [1200, 1600], "height": 10 },
    { "op": "hill", "center": [4700, 7200], "radius": [1000, 500], "height": 4 },

    // Река с севера впадает в озеро на востоке; карту она не разрезает.
    { "op": "path", "layer": "water", "kind": "river", "width": 60,
      "points": [[6800, 0], [6600, 1400], [6900, 2800], [7000, 3400]] },
    { "op": "ellipse", "layer": "water", "kind": "lake", "center": [7050, 3800], "radius": [500, 320] },
    { "op": "hill", "center": [7050, 3800], "radius": [520, 340], "height": -2 },
    { "op": "ellipse", "layer": "surface", "kind": "sand", "center": [7050, 3800], "radius": [560, 380] },

    // Леса.
    { "op": "ellipse", "layer": "vegetation", "kind": "forest", "center": [4300, 1500], "radius": [1000, 600] },
    { "op": "ellipse", "layer": "vegetation", "kind": "forest", "center": [1900, 4900], "radius": [800, 1000] },
    { "op": "ellipse", "layer": "vegetation", "kind": "forest", "center": [6500, 5300], "radius": [700, 900] },
    { "op": "ellipse", "layer": "vegetation", "kind": "forest", "center": [500, 7400], "radius": [800, 500] },
    { "op": "ellipse", "layer": "vegetation", "kind": "forest", "center": [3000, 6500], "radius": [500, 400] },

    // Луга и поля вокруг города.
    { "op": "ellipse", "layer": "surface", "kind": "meadow", "center": [3900, 4600], "radius": [1300, 800] },
    { "op": "rect", "layer": "surface", "kind": "field", "rect": [2600, 4300, 500, 300] },
    { "op": "rect", "layer": "surface", "kind": "field", "rect": [4500, 4500, 400, 500] },
    { "op": "rect", "layer": "surface", "kind": "field", "rect": [3000, 5000, 600, 250] },

    // Месторождения под шахтами.
    { "op": "ellipse", "layer": "deposit", "kind": "coal", "center": [4920, 3120], "radius": [300, 240] },
    { "op": "ellipse", "layer": "deposit", "kind": "iron_ore", "center": [2820, 3320], "radius": [300, 240] },

    // Ровные площадки под объектами.
    { "op": "level", "rect": [3740, 4290, 320, 320], "height": 0 },
    { "op": "level", "rect": [3880, 3880, 140, 120], "height": 0 },
    { "op": "level", "rect": [4880, 3080, 80, 80], "height": 0 },
    { "op": "level", "rect": [2780, 3280, 80, 80], "height": 0 }
  ],

  "networks": [
    // Внутренние улицы города: кварталы по 150 м. Внешних дорог и путей нет — их строит игрок.
    { "op": "grid", "network": "road", "rect": [3750, 4300, 300, 300], "spacing": 30 }
  ],

  "sites": [
    // stock — начальные запасы сценария, т (docs/03). Без транспорта их хватит заводу на 3 дня, городу — на 2.
    { "key": "city", "type": "city", "name": "Город", "rect": [3750, 4300, 300, 300], "stock": { "steel": 300 } },
    { "key": "coal_mine", "type": "coal_mine", "name": "Угольная шахта", "rect": [4900, 3100, 40, 40] },
    { "key": "iron_mine", "type": "iron_mine", "name": "Железорудная шахта", "rect": [2800, 3300, 40, 40] },
    { "key": "steel_plant", "type": "steel_plant", "name": "Металлургический завод", "rect": [3900, 3900, 100, 80],
      "stock": { "coal": 600, "iron_ore": 900 } }
  ]
}
