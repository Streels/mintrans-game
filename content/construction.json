// Правила строительства игроком (docs/02, docs/06, docs/10, docs/10а, docs/10б). Денег пока нет — бюджет в теме 09.
{
  // Где нельзя строить совсем. Реку и озеро пересекают мостом: под пролётом вода разрешена.
  "forbiddenTerrain": [
    { "category": "water", "kinds": ["river", "lake"] }
  ],

  // На свободных клетках сеть можно класть всегда. На площадках объектов —
  // только на перечисленных типах объектов (siteTypes) или частях площадки (parts).
  // Рельсы через площадки не проходят вовсе: станция — платформа на пути рядом с предприятием (docs/10в).
  "networks": [
    { "network": "rail", "siteTypes": [], "parts": [] },
    { "network": "road", "siteTypes": ["city"], "parts": ["truck_station"] }
  ],

  // Какие сети могут пересекаться в одном уровне переездом (docs/10а): прямая дорога поперёк прямого пути.
  // Две ж/д линии в одном уровне не пересекаются — только стрелкой или мостом (docs/10в, раздел 7).
  "levelCrossings": [
    ["road", "rail"]
  ],

  // Грузовые станции предприятий (docs/10, docs/10в, раздел 4).
  //   Ж/д станция — платформы на прямых путях рядом с предприятием: maxDistanceM — насколько ось пути может
  //   отстоять от площадки (четыре параллельных пути через 5 м), maxTracks — сколько платформ (по составу на каждую).
  //   Длину платформы игрок выбирает поклеточно, без предела.
  //   Автостанция — полоса клеток вплотную к площадке, становится её частью; maxLength — длина вдоль дороги.
  "stations": [
    { "id": "rail_station", "network": "rail", "maxTracks": 4, "maxDistanceM": 20,
      "attachTo": ["coal_mine", "iron_mine", "steel_plant"] },
    { "id": "truck_station", "network": "road", "maxLength": 4,
      "attachTo": ["coal_mine", "iron_mine", "steel_plant"] }
  ],

  // Мосты (docs/10б): прямые, от опоры до опоры; maxLength — в клетках вместе с опорами.
  // Ж/д мост — путь уровнем выше земли. Под пролётом — пути, дороги, вода; не площадки и не другие мосты.
  // Тоннели появятся вместе со склонами рельефа.
  "bridges": [
    { "id": "rail_bridge", "network": "rail", "maxLength": 12 },
    { "id": "road_bridge", "network": "road", "maxLength": 12 }
  ],

  // Сигналы (docs/10а, модель OpenTTD):
  //   block — блочный: пускает поезд, если следующий участок до сигналов пуст;
  //   path  — маршрутный: закрепляет за поездом путь до следующего безопасного места,
  //           поэтому через одну развязку могут идти несколько поездов, если их пути не пересекаются.
  "signals": [
    { "id": "block_signal", "network": "rail", "logic": "block" },
    { "id": "path_signal", "network": "rail", "logic": "path" }
  ],

  // Железнодорожный редактор на метрической геометрии (docs/10в): черновые параметры v1, не строительные нормы.
  //   minRadiusM            — наименьший радиус кривой, один для всего подвижного состава;
  //   radiusCandidatesM     — радиусы, которые перебирает колесо мыши в предпросмотре соединения А→Б;
  //   maxArcSweepDeg        — наибольший угол одной дуги соединения;
  //   maxDefaultDetourRatio — вариант по умолчанию не длиннее кратчайшего во столько раз (выбирается наибольший радиус);
  //   corridorHalfWidthM    — половина ширины строительного коридора пути: оси путей через 5 м не конфликтуют.
  "railEditor": {
    "minRadiusM": 200,
    "radiusCandidatesM": [200, 250, 300, 400, 500, 750, 1000],
    "maxArcSweepDeg": 90,
    "maxDefaultDetourRatio": 1.35,
    "corridorHalfWidthM": 2.0
  },

  // Сооружения вне площадок предприятий (docs/10):
  //   railDepot     — ж/д депо на прямом пути, maxLength клеток; здесь покупают поезда, выезжать можно в обе стороны;
  //   depot         — автогараж: одна клетка с въездом с одной стороны (сторона — по протяжке мышью);
  //   stopOnNetwork — пункт на уже проложенной сети внутри площадки объекта (городской грузовой пункт на улице).
  "facilities": [
    { "id": "rail_depot", "title": "Ж/д депо", "network": "rail", "placement": "railDepot", "maxLength": 4 },
    { "id": "truck_garage", "title": "Автогараж", "network": "road", "placement": "depot" },
    { "id": "city_truck_stop", "title": "Городской грузовой пункт", "network": "road",
      "placement": "stopOnNetwork", "siteTypes": ["city"], "maxLength": 3 }
  ]
}
